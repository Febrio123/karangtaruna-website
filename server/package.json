{
  "name": "karang-taruna-api",
  "version": "1.0.0",
  "description": "Backend API Karang Taruna Mangga Dua Selatan — autentikasi JWT + refresh token, CRUD konten publik, transparansi anggaran, prediksi anggaran (WMA + inflasi).",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset",
    "test": "node --test",
    "test:watch": "node --test --watch test/",
    "set-role": "node src/scripts/setRole.js"
  },
  "keywords": [
    "karang-taruna",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "cloudinary",
    "wma"
  ],
  "author": "Karang Taruna Mangga Dua Selatan",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "supertest": "^7.2.2"
  }
}
