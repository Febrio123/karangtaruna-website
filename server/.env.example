# ============================================================================
# Karang Taruna API — Environment Variables
# Salin file ini menjadi `.env` lalu isi nilai asli. JANGAN commit `.env`.
# ============================================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- Database (MongoDB) ---
# Contoh URI Atlas: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/karang_taruna
MONGO_URI=mongodb://localhost:27017/karang_taruna

# --- JWT — gunakan string acak panjang (>= 32 karakter) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_random
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_random
# Durasi access token (short-lived)
JWT_ACCESS_EXPIRES_IN=15m
# Durasi refresh token default (tanpa centang "ingat saya")
JWT_REFRESH_EXPIRES_IN=7d
# Durasi refresh token ketika user mencentang "ingat saya" (cookie & token diperpanjang)
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d

# --- Cookie ---
# true = hanya dikirim via HTTPS (production). false = via HTTP (dev lokal)
COOKIE_SECURE=false
# lax | strict | none
COOKIE_SAMESITE=lax
# Nama cookie refresh token
COOKIE_REFRESH_NAME=rt_refresh_token

# --- CORS — daftar origin yang diizinkan, pisahkan dengan koma ---
# Contoh: https://dashboard.example.com,https://user.example.com,http://localhost:5173
# Jika dikosongkan (dev), semua origin diizinkan (dengan credentials).
CORS_ORIGIN=

# --- Cloudinary (storage media foto/video) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder default untuk aset Cloudinary
CLOUDINARY_FOLDER=karang-taruna

# --- Captcha (sederhana, sisi server) ---
# true = login WAJIB captcha. false = lewati (untuk dev/testing).
CAPTCHA_ENABLED=true

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# --- Seed admin (dipakai `npm run seed`) ---
SEED_ADMIN_USERNAME=ketua
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=ketua@ktmekarjaya.local