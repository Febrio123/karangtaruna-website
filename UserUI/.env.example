# Cloud name dari akun Cloudinary kamu
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name

# Endpoint Formspree untuk form kontak
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/xxxxx

# URL situs (untuk canonical, Open Graph, JSON-LD)
# Di development: http://localhost:5173
# Di production (Vercel): ganti dengan URL deployment, misal https://kt-mekarjaya.vercel.app
VITE_SITE_URL=http://localhost:5173
